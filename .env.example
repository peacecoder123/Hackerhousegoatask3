# FaceChain Verify — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit the actual .env file (it's in .gitignore).

# ── Step 2: Web Search ─────────────────────────────────────────────
# Get your key at https://serpapi.com/
SERPAPI_KEY=

# ── Step 3: Blockchain ─────────────────────────────────────────────
# Infura or Alchemy project URL for Ethereum Sepolia
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Your Sepolia wallet private key (KEEP SECRET — never commit)
WALLET_PRIVATE_KEY=

# Deployed FaceChainVerify contract address (fill in after running deploy.js)
CONTRACT_ADDRESS=

# Optional: Etherscan API key for contract source verification
ETHERSCAN_API_KEY=
